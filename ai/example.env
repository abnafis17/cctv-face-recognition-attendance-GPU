# -----------------------------------------------------------------------------
# AI service environment (attendance + presence + MJPEG streams)
# -----------------------------------------------------------------------------

# AI_SERVER_HOST=172.24.128.1

AI_SERVER_PORT=8000

# Backend API integration
# BACKEND_BASE_URL=http://10.81.100.128:3001
BACKEND_BASE_URL=http://10.81.100.128:3001
BACKEND_API_PREFIX=/api/v1
# Optional default company ID when request headers/params do not provide one.
BACKEND_COMPANY_ID=

# Door relay / welcome control
# RELAY_ON_URL and RELAY_SILENT_URL are no longer used.
# Relay endpoints are now resolved company-wise from backend settings.
RELAY_MIN_INTERVAL_S=0.75
RELAY_HTTP_TIMEOUT_S=1.2
DOOR_HTTP_TIMEOUT_S=1.2
RELAY_FAIL_LOG_COOLDOWN_S=8
DOOR_FAIL_LOG_COOLDOWN_S=8
DOOR_UNLOCK_ON_RECOGNITION=1
DOOR_UNLOCK_MIN_GAP=5.0             #door unlock minimum gap in seconds (rely on api call debounce and take attendance)

# ERP push integration
ERP_BASE_URL=http://172.20.60.101:7001
ERP_PREFIX=/api/v2
ERP_TIMEOUT_S=10
ERP_API_VERSION=2.0

# Optional integration secret (kept from existing config)
AGENT_TOKEN_SECRET=7e6b2b79c3d4c1a54d2f9b3a7c2f6f0d1c9e8b7a6d5c4b3a2f1e0d9c8b7a6f5e4d3c2b1a09f8e7d6c5b4a392817161514131211100f0e0d0c0b0a0908

# GPU / model runtime
USE_GPU=1
ORT_PROVIDER=cuda
EMBED_USE_GPU=1
ORT_INTRA_OP_NUM_THREADS=2
ORT_INTER_OP_NUM_THREADS=1
OPENCV_NUM_THREADS=2
TORCH_NUM_THREADS=2

# Face detector + recognition throughput (tuned for Jetson Orin Nano)
AI_DET_SIZE=640
AI_FPS=10
MIN_FACE_DET_SCORE=0.28
FALLBACK_DET_SCORE=0.0

# Efficient lightweight model selection with buffalo_sc (det_500m + w600k_mbf, 100% DB compatible)
INSIGHTFACE_MODEL=buffalo_sc
PRESENCE_FACE_MODEL=buffalo_sc

# Capture backend + recovery (RTSP/Webcam)
# STREAM_CAPTURE_BACKEND: auto|ffmpeg|opencv
STREAM_CAPTURE_BACKEND=auto
CAMERA_DEFAULT_WIDTH=960
CAMERA_DEFAULT_HEIGHT=540
CAMERA_DEFAULT_INGEST_FPS=15

# FFmpeg capture tuning (used when backend is ffmpeg)
FFMPEG_CAPTURE_LOGLEVEL=error
FFMPEG_CAPTURE_RTSP_TRANSPORT=tcp
FFMPEG_CAPTURE_RTSP_FLAGS=prefer_tcp
FFMPEG_CAPTURE_FFLAGS=nobuffer+discardcorrupt
FFMPEG_CAPTURE_FLAGS=low_delay
FFMPEG_CAPTURE_TIMEOUT_US=0
FFMPEG_CAPTURE_RW_TIMEOUT_US=15000000
FFMPEG_CAPTURE_PROBESIZE=250000
FFMPEG_CAPTURE_ANALYZEDURATION=250000
FFMPEG_CAPTURE_MAX_DELAY_US=50000
FFMPEG_CAPTURE_REORDER_QUEUE_SIZE=0
FFMPEG_CAPTURE_USE_WALLCLOCK=0
FFMPEG_CAPTURE_STARTUP_FRAME_TIMEOUT_S=15
FFMPEG_CAPTURE_MAX_STARTUP_FAILS_BEFORE_FALLBACK=6
FFMPEG_CAPTURE_AUTO_FALLBACK_TO_OPENCV=1
FFMPEG_CAPTURE_STDERR_TAIL_LINES=12
FFMPEG_CAPTURE_THREADS=2
FFMPEG_CAPTURE_DECODER=
FFMPEG_HWACCEL=none
FFMPEG_HWACCEL_DEVICE=

# OpenCV fallback capture tuning
FRAME_STALE_SEC=3.0
FRAME_MAX_FAILS=15
FRAME_REOPEN_WAIT_SEC=0.3
CAP_OPEN_TIMEOUT_MS=2000
CAP_READ_TIMEOUT_MS=2000
# OpenCV FFmpeg low-latency flags (matches runtime default)
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|fflags;nobuffer|max_delay;0|flags;low_delay|reorder_queue_size;0|threads;2|fflags;discardcorrupt|rw_timeout;3000000|stimeout;3000000

# Recognition scheduler / cadence (Smooth Jetson pipeline)
DETECTION_FPS_IDLE=4
DETECTION_FPS_NORMAL=10
DETECTION_FPS_BURST=18
BURST_SECONDS=3
IDLE_SECONDS=1.0
MOTION_THRESHOLD=0.015
MOTION_COOLDOWN_SECONDS=0.40
EMBED_REFRESH_SECONDS=0.10
EMBED_REFRESH_UNKNOWN_SECONDS=0.07
UNKNOWN_BURST_AFTER_SECONDS=0.20
KNOWN_IDENTITY_LATCH_ENABLED=0
KNOWN_IDENTITY_LATCH_MIN_HITS=2

# Attendance / match quality gates
SIMILARITY_THRESHOLD=0.35
BORDERLINE_MARGIN=0.04
DISTINCT_SIM_MARGIN=0.02
STRICT_SIM_THRESHOLD=0.36
MIN_ATT_QUALITY=6.0

# Recognition quality gate (relaxed defaults for wide-angle CCTV)
RECOGNITION_QUALITY_GATE_ENABLED=1
RECOGNITION_MIN_FACE_PX=14
RECOGNITION_MIN_BRIGHTNESS=8
RECOGNITION_MIN_SHARPNESS=4
RECOGNITION_MAX_ABS_YAW=82
RECOGNITION_MAX_ABS_PITCH=75
EMBEDDING_FUSION_WINDOW=3

# Inference-time low-light enhancement
LOW_LIGHT_ENHANCE_ENABLED=1
LOW_LIGHT_LUMA_THRESHOLD=88
LOW_LIGHT_TARGET_LUMA=118
LOW_LIGHT_MIN_CONTRAST=20
LOW_LIGHT_CLAHE_CLIP_LIMIT=2.0
LOW_LIGHT_CLAHE_TILE_GRID=8
LOW_LIGHT_GAMMA_MIN=0.55
LOW_LIGHT_GAMMA_MAX=1.0
LOW_LIGHT_DENOISE_ENABLED=0

ATTENDANCE_FAST_MODE=1
FAST_MODE_KEEP_STRICT_CHECKS=1
ALLOW_SINGLE_SAMPLE_ATTENDANCE=1
VERIFICATION_SAMPLES=1
STABLE_ID_CONFIRMATIONS=2
ATTENDANCE_DEBOUNCE_SECONDS=30.0
ATTENDANCE_REQUIRE_EXTRA_QUALITY_GATE=0
ATTENDANCE_REQUIRE_FAS=0

# Identity hold / anti-flicker controls
IDENTITY_HOLD_SECONDS=0.8
IDENTITY_HOLD_MAX_DET_MISSES=3
IDENTITY_HOLD_MIN_IOU=0.02
IDENTITY_HOLD_MAX_CENTER_SHIFT_RATIO=0.45
IDENTITY_HOLD_ZONE_ENABLED=0
IDENTITY_HOLD_ZONE_SCALE=1.00
IDENTITY_HOLD_ZONE_RECHECK_SECONDS=0
BODY_PERSISTENCE_ENABLED=0
BODY_PERSIST_DET_FPS=20
BODY_PERSIST_MAX_LOST_S=0.5
BODY_PERSIST_VISIBLE_HOLD_S=0.3
BODY_PERSIST_IDENTITY_TTL_S=10.0
BODY_PERSIST_MAX_MISSES=1
BODY_PERSIST_DRAW_MAX_STALE_S=5.0
BODY_PERSIST_DRAW_MAX_MISSES=120
BODY_PERSIST_DRAW_FALLBACK_OVERLAY=1
FACE_OVERLAY_MAX_STALE_S=1.0
FACE_OVERLAY_MAX_DET_MISSES=10
BODY_PERSIST_KNOWN_MATCH_MIN_SCORE=0.85
BODY_PERSIST_FACE_MATCH_MIN_SCORE=0.75
BODY_PERSIST_BODY_EXPAND_X_RATIO=0.30
BODY_PERSIST_BODY_EXPAND_Y_RATIO=0.24
BODY_PERSIST_BODY_EXPAND_TOP_RATIO=0.35
BODY_PERSIST_FACE_MAX_Y_RATIO=0.96
BODY_PERSIST_UNKNOWN_SUPPRESS_IOU=0.18
FACE_KNOWN_DRAW_SCALE=1.0
BODY_PERSIST_FACE_REL_ALPHA=0.35
BODY_PERSIST_FACE_DRAW_SMOOTH_ALPHA=0.75
BODY_PERSIST_REBIND_IOU_MIN=0.35
BODY_PERSIST_REBIND_CENTER_RATIO=0.50
BODY_PERSIST_REBIND_MIN_SCORE=0.85
BODY_PERSIST_FACE_FALLBACK_MAX_AGE_S=1.0
BODY_PERSIST_ERROR_LOG_INTERVAL_S=10.0
IDENTITY_CONF_DECAY_VISIBLE_PER_S=0.002
IDENTITY_CONF_DECAY_MISSING_PER_S=0.16
IDENTITY_CONF_BOOST_FACE=0.22
IDENTITY_CONF_BOOST_BODY=0.03
IDENTITY_CONF_MIN_SHOW=0.18
IDENTITY_CONF_DROP=0.08
IDENTITY_PARTIAL_OCCLUSION_AFTER_S=0.55
IDENTITY_FULL_OCCLUSION_AFTER_S=1.60
BODY_EMBEDDING_BANK_SIZE=12
ATTENDANCE_MAX_EMBED_AGE_S=1.0
ATTENDANCE_MIN_ID_AGE_S=0.15
MAX_DET_RESULT_AGE_S=0.60
KPS_MAX_AGE_S=0.35

# Pipeline internals
GPU_QUEUE_SIZE=3
PIPELINE_LOG_INTERVAL_S=5.0
TRACK_MAX_AGE_FRAMES=30
TRACK_IOU_MATCH_THRESHOLD=0.25
TRACK_CENTER_MATCH_PX=200.0
TRACK_KNOWN_REACQUIRE_CLEAR_IOU=0.18
TRACK_KNOWN_REACQUIRE_CLEAR_CENTER_RATIO=0.65
TRACK_MAX_DET_MISSES_UNKNOWN=0
TRACK_MAX_DET_MISSES_KNOWN=3
ATT_VOICE_MAX_EVENTS=500
MIN_DET_QUALITY=8.0

# FAS (anti-spoof) runtime
FAS_ENABLED=1
FAS_ONNX_PATH=app/fas/models/fas.onnx
FAS_THRESHOLD=0.55
FAS_MOTION_WINDOW=2.0
FAS_USE_HEURISTICS=1
FAS_COOLDOWN_SEC=2.0
FAS_CLOSE_FACE_MAX_AREA_RATIO=0.25
FAS_CLOSE_FACE_MAX_WIDTH_RATIO=0.70
FAS_MIN_YAW_RANGE=0.03
FAS_SKIP_LAPTOP=1
FAS_ALLOW_NO_POSE_FOR_ATTENDANCE=1

# Legacy/auxiliary FAS keys kept for compatibility with older tooling
FAS_OVERLAY_EMA_ALPHA=0.20
FAS_HUMAN_ON=0.55
FAS_HUMAN_OFF=0.30
FAS_HUMAN_NEED_HITS=2
FAS_SPOOF_NEED_HITS=6
FAS_BLUR_HOLD_VAR=70
FAS_CHALLENGE_ENABLED=1
FAS_CHALLENGE_TTL_SEC=3.0
FAS_YAW_THRESHOLD=0.22

# MJPEG stream behavior (raw / recognition / presence / enroll)
MJPEG_INITIAL_WAIT_S=3
MJPEG_NO_FRAME_TIMEOUT_S=12
MJPEG_STREAM_FPS_RAW=10
MJPEG_STREAM_FPS_RECOGNITION=10
MJPEG_STREAM_FPS_PRESENCE=8
MJPEG_STREAM_FPS_ENROLL=10
MJPEG_RAW_JPEG_QUALITY=50
MJPEG_RECOGNITION_FALLBACK_JPEG_QUALITY=50
MJPEG_PRESENCE_FALLBACK_JPEG_QUALITY=50
MJPEG_ENROLL_JPEG_QUALITY=60
RECOGNITION_MAX_CACHED_JPEG_AGE_S=1.5
PRESENCE_MAX_CACHED_JPEG_AGE_S=1.5
MJPEG_GRID_MAX_FPS=6
MJPEG_GRID_MAX_WIDTH=640
MJPEG_GRID_MAX_HEIGHT=360
MJPEG_GRID_MAX_JPEG_QUALITY=45
MJPEG_FOCUS_MIN_FPS=8
MJPEG_FOCUS_MAX_FPS=12
MJPEG_FOCUS_MAX_JPEG_QUALITY=64
MJPEG_GRID_TARGET_KBPS=1100
MJPEG_FOCUS_TARGET_KBPS=1800
MJPEG_ENABLE_DEFAULT_TARGET_KBPS=1
MJPEG_DYNAMIC_MIN_QUALITY=28
MJPEG_DYNAMIC_MAX_QUALITY=90
MJPEG_DYNAMIC_EMA_ALPHA=0.2
MJPEG_DYNAMIC_ADJUST_INTERVAL_S=0.3

# Presence runtime
PRESENCE_AI_FPS=8
PRESENCE_IDLE_AI_FPS=1.0
PRESENCE_IDLE_AFTER_S=2.0
PRESENCE_ERROR_LOG_INTERVAL_S=10.0

PRESENCE_DET_MODE=person
PRESENCE_ALLOW_HOG_FALLBACK=0
PRESENCE_YOLO_MODEL=yolov8s-seg.pt
PRESENCE_CONF=0.18
PRESENCE_IOU=0.45
PRESENCE_IMG_SIZE=640
PRESENCE_DEVICE=cuda:0
PRESENCE_MAX_DET=100

PRESENCE_FACE_MODEL=buffalo_sc
PRESENCE_FACE_DET_SIZE=640
PRESENCE_FACE_MIN_SIZE=30
PRESENCE_FACE_MIN_SCORE=0.35

PRESENCE_MATCH_IOU=0.30
PRESENCE_MATCH_CENTER_RATIO=0.70
PRESENCE_REACQUIRE_CENTER_RATIO=1.10
PRESENCE_MAX_LOST_S=2.0
PRESENCE_MIN_HITS=1
PRESENCE_EXIT_LIMIT=50
PRESENCE_BBOX_SMOOTH_ALPHA=0.75
PRESENCE_DET_NMS_IOU=0.65
PRESENCE_ACTIVE_HOLD_S=0.60
PRESENCE_MAX_MISSES=8

# FFmpeg path overrides (leave blank to use PATH auto-detection)
FFMPEG_EXE=

# HLS (H.264 / H.265 browser delivery)
# Use h264 for maximum browser compatibility. Set to h265 for lower bitrate
# where your target browsers/devices support HEVC playback.
HLS_VIDEO_CODEC=h264
# Optional per-view codec override:
# - Keep grid on h264 for widest browser compatibility.
# - Use h265 on focus only if your target clients support HEVC playback.
HLS_GRID_VIDEO_CODEC=h264
HLS_FOCUS_VIDEO_CODEC=h264
HLS_SEGMENT_TYPE=mpegts
HLS_FFMPEG_PRESET=veryfast
HLS_CRF=23
HLS_SEGMENT_TIME_S=0.6
HLS_LIST_SIZE=3
HLS_KEYINT_SECONDS=1.0
HLS_GRID_TARGET_KBPS=500
HLS_FOCUS_TARGET_KBPS=1500
HLS_MAX_ANNOTATED_FRAME_AGE_S=0.45
CAMERA_VIEW_GRID_MIN_FPS=8
CAMERA_VIEW_FOCUS_MIN_FPS=10
# Force recognition grid view to capture from camera substream.
HLS_RECOGNITION_GRID_USE_SUBSTREAM=1
# If grid substream has no frames, auto-fallback to main stream quickly.
HLS_GRID_AUTO_FALLBACK_TO_MAIN=1
HLS_GRID_FALLBACK_WAIT_S=2.5
SUPPRESS_HLS_ACCESS_LOG=1
HLS_FILE_OPEN_RETRIES=12
HLS_FILE_OPEN_RETRY_DELAY_S=0.03

BODY_PERSIST_TRACKER_BACKEND=botsort
BODY_PERSIST_TRACK_FPS=25
BODY_PERSIST_IDENTITY_LOCK_SECONDS=3.0
BODY_PERSIST_SWITCH_MIN_SIM_GAIN=0.15
