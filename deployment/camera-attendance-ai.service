[Unit]
Description=Camera Attendance AI Engine (FastAPI / YOLO / InsightFace)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=psl
Group=psl
WorkingDirectory=/home/psl/PSL_Projects/camera-auto-attendance-ai/ai
Environment=PYTHONUNBUFFERED=1
Environment=AI_SERVER_PORT=8080
Environment=PORT=8080
Environment=BACKEND_BASE_URL=http://10.81.100.50:4000
Environment=PATH=/home/psl/PSL_Projects/camera-auto-attendance-ai/ai/venv/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/psl/PSL_Projects/camera-auto-attendance-ai/ai/venv/bin/python run.py

Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# Jetson memory safeguard
MemoryMax=5G
MemoryHigh=4.5G

[Install]
WantedBy=multi-user.target
