# -----------------------------------------------------------------------------
# Front-end environment (public vars exposed to browser)
# -----------------------------------------------------------------------------

# Backend API origin
# NEXT_PUBLIC_BACKEND_URL=http://10.81.100.128:3001
NEXT_PUBLIC_BACKEND_URL=http://10.81.100.57:3001

# AI service origin (camera/presence streams)
# NEXT_PUBLIC_AI_URL=http://10.81.100.128:8000
NEXT_PUBLIC_AI_URL=http://10.81.100.128:8000

# ERP API origin
NEXT_PUBLIC_ERP_URL=http://172.20.60.101:7001

# Backend route prefix used by src/lib/api.ts
NEXT_PUBLIC_BACKEND_API_PREFIX=/api/v1

# Optional: media host/CDN for assets
NEXT_PUBLIC_MEDIA_URL=

# Optional: explicit client/LAN address shown by UI features
NEXT_PUBLIC_CLIENT_ADDRESS=


# Optional: WHEP base URL for direct camera stream consumption by browser (WebRTC)
NEXT_PUBLIC_MEDIA_WHEP_BASE_URL=http://127.0.0.1:8889
NEXT_PUBLIC_MEDIA_WHEP_PATH_TEMPLATE=/{companyId}/{cameraId}/{source}/whep
NEXT_PUBLIC_MEDIA_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
NEXT_PUBLIC_MEDIA_ALLOW_RECOGNITION_WEBRTC=1