# -----------------------------------------------------------------------------
# Backend service environment
# -----------------------------------------------------------------------------

# Primary app database (Prisma)
DATABASE_URL=postgresql://postgres:1234567@10.81.100.128:5432/cctv-attendance-project

# API server
PORT=3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3002,http://10.81.100.113:3000,http://10.81.100.128:3000,http://10.81.100.128:3002,http://10.81.100.32:3000,http://10.81.100.69:3000,http://10.81.100.185:8000,http://10.81.100.185:3000,http://10.81.100.185:3002

# AI service endpoint used by control routes and autostart
# AI_BASE_URL=http://10.81.100.128:8000
AI_BASE_URL=http://10.81.100.185:8000


AI_START_TIMEOUT_MS=30000
AI_STOP_TIMEOUT_MS=5000

# JWT auth
ACCESS_TOKEN_SECRET=replace_with_strong_secret
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_DAYS=14

# Camera autostart / health check tuning
AUTO_START_RTSP_CAMERAS=1
AUTO_START_LOCAL_SOURCES=0
AI_HEALTH_TIMEOUT_MS=2000
AI_HEALTH_WAIT_MAX_MS=60000
AI_HEALTH_RETRY_DELAY_MS=1500
CAMERA_AUTOSTART_RETRY_MS=30000

# In-memory event queue sizes
ATT_EVENTS_MAX=500
HC_EVENTS_MAX=500

# Duplicate recognition cooldown shared with attendance/gatepass return matching
ATTENDANCE_DEBOUNCE_SECONDS=30.0

# Headcount run grouping window (minutes)
HEADCOUNT_RUN_GAP_MINUTES=15

# ERP MSSQL connection (used by ERP sync routes)
ERP_DB_HOST=127.0.0.1
ERP_DB_PORT=1433
ERP_DB_NAME=erp
ERP_DB_USER=sa
ERP_DB_PASSWORD=change_me
MSSQL_ENCRYPT=false



# Media matrix integration (optional, for camera stream management and WebRTC)
MEDIA_MTX_SYNC_ENABLED=1
MEDIA_MTX_API_BASE_URL=http://127.0.0.1:9997
MEDIA_MTX_PATH_PREFIX=
MEDIA_MTX_RTSP_TRANSPORT=tcp
MEDIA_MTX_SOURCE_ON_DEMAND=1
MEDIA_MTX_SOURCE_ON_DEMAND_START_TIMEOUT=12s
MEDIA_MTX_SOURCE_ON_DEMAND_CLOSE_AFTER=20s