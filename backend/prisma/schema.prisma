generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
}

model Company {
  id              String   @id @default(cuid())
  companyName     String
  organization_id String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  employees     Employee[]
  faceTemplates FaceTemplate[]
  attendances   Attendance[]
  unknownRecognitions UnknownRecognition[]
  cameras       Camera[]
  boundingBoxTrackingRows CameraBoundingBoxTracking[]
  refreshTokens RefreshToken[]

  // ✅ Added (relay)
  relayAgents RelayAgent[]
  pairCodes   PairCode[]
  relaySettings CompanyRelaySetting[]
  erpSettings   CompanyErpSetting[]

  headcounts Headcount[]
  otRequisitions OtRequisition[]
  gatepassRows    GatepassTable[]
  visitors        Visitor[]
  visitorTypes    VisitorType[]
  purposeOfVisits PurposeOfVisit[]
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  isActive     Boolean  @default(true)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
}

model Employee {
  id         String  @id @default(cuid())
  empId      String? @map("emp_id")
  name       String
  unit       String?
  section    String?
  department String?
  line       String?
  companyId  String?
  empPicUrl  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance Attendance[]
  templates  FaceTemplate[]
  cameraAuthorizations CameraAuthorizedEmployee[]
  boundingBoxAssignments CameraBoundingBoxEmployee[]
  boundingBoxTrackingRows CameraBoundingBoxTracking[]

  headcounts Headcount[]
  otRequisitions OtRequisition[]
  gatepassRows    GatepassTable[]

  @@unique([companyId, empId])
  @@index([empId])
  @@index([companyId])
  @@index([companyId, unit])
  @@index([companyId, section])
  @@index([companyId, department])
  @@index([companyId, line])
}

model FaceTemplate {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  angle     String
  modelName String
  embedding Float[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, angle])
  @@index([employeeId])
  @@index([companyId])
}

model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  timestamp  DateTime
  cameraId   String?
  confidence Float?

  createdAt DateTime @default(now())

  camera     Camera?  @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  @@index([employeeId, timestamp])
  @@index([companyId, timestamp])
}

model UnknownRecognition {
  id        String   @id @default(cuid())
  timestamp DateTime
  confidence Float?
  recognizedName String? @map("name")

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  cameraId String?
  camera   Camera? @relation(fields: [cameraId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([companyId, timestamp])
  @@index([cameraId, timestamp])
}

model Camera {
  id       String  @id @default(cuid())
  camId    String? @map("cam_id")
  name     String
  rtspUrl  String? // ✅ keep optional (relay cameras won't store plaintext RTSP)
  isActive   Boolean  @default(false)
  attendance Boolean? @default(false)
  task       String   @default("attendance")

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  attendances Attendance[]
  unknownRecognitions UnknownRecognition[]
  authorizedEmployees CameraAuthorizedEmployee[]
  boundingBoxes CameraBoundingBox[]
  boundingBoxTrackingRows CameraBoundingBoxTracking[]
  headcounts  Headcount[]
  otRequisitions OtRequisition[]
  gatepassRequestRows GatepassTable[] @relation("GatepassRequestCamera")
  gatepassReturnRows  GatepassTable[] @relation("GatepassReturnCamera")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ✅ Added (relay support)
  relayAgentId String?
  relayAgent   RelayAgent? @relation(fields: [relayAgentId], references: [id], onDelete: SetNull)

  // Encrypted RTSP blob stored as JSON string
  // Example: {"encKey":"...","iv":"...","tag":"...","ciphertext":"..."}
  rtspUrlEnc String? @db.Text

  // Relay send controls
  sendFps     Int @default(2)
  sendWidth   Int @default(640)
  sendHeight  Int @default(360)
  jpegQuality Int @default(70)

  @@unique([companyId, camId])
  @@index([camId])
  @@index([companyId])
  @@index([relayAgentId])
}

model CameraAuthorizedEmployee {
  cameraId   String
  employeeId String

  camera   Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([cameraId, employeeId])
  @@index([cameraId])
  @@index([employeeId])
}

model CameraBoundingBox {
  id    String @id @default(cuid())
  name  String

  cameraId String
  camera   Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  topLeftX     Float
  topLeftY     Float
  topRightX    Float
  topRightY    Float
  bottomLeftX  Float
  bottomLeftY  Float
  bottomRightX Float
  bottomRightY Float

  employees CameraBoundingBoxEmployee[]
  trackingRows CameraBoundingBoxTracking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cameraId])
  @@index([cameraId, sortOrder])
}

model CameraBoundingBoxEmployee {
  id String @id @default(cuid())

  boundingBoxId String
  employeeId    String

  boundingBox CameraBoundingBox @relation(fields: [boundingBoxId], references: [id], onDelete: Cascade)
  employee    Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([boundingBoxId, employeeId])
  @@index([boundingBoxId])
  @@index([employeeId])
}

model CameraBoundingBoxTracking {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  cameraId String
  camera   Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  boundingBoxId String
  boundingBox   CameraBoundingBox @relation(fields: [boundingBoxId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  outTime DateTime
  inTime  DateTime?
  durationSeconds Int?
  status String @default("out")
  confidence Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, outTime])
  @@index([cameraId, outTime])
  @@index([boundingBoxId, outTime])
  @@index([employeeId, outTime])
  @@index([companyId, cameraId, status, outTime])
}

model RefreshToken {
  id        String @id @default(cuid())
  tokenHash String @unique
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  revokedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([companyId])
}

//
// ✅ NEW MODELS (relay agent)
//

model RelayAgent {
  id   String @id @default(cuid())
  name String

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  publicKeyPem String @db.Text

  // keep your field name as-is
  refreshTokenHash String

  isActive   Boolean  @default(true)
  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cameras   Camera[]
  pairCodes PairCode[] // ✅ added because PairCode now links to RelayAgent

  @@unique([companyId, name])
  @@index([companyId])
  @@index([lastSeenAt])
}

model PairCode {
  code String @id

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  agentName String
  expiresAt DateTime

  // ✅ REQUIRED: prevent reuse + link which agent claimed it
  usedAt DateTime?
  agentId String?
  agent   RelayAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([expiresAt])
  @@index([agentId])
}

model CompanyRelaySetting {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  urlType String @default("door")
  relayOnUrl     String? @db.Text
  relaySilentUrl String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, urlType])
  @@index([companyId])
}

model CompanyErpSetting {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  urlType String @default("attendance")
  erpBaseUrl            String? @db.Text
  erpPrefix             String? @db.Text
  erpAttendanceEndpoint String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, urlType])
  @@index([companyId])
}


model Headcount {
  id         String   @id @default(cuid())

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  cameraId   String?
  camera     Camera?   @relation(fields: [cameraId], references: [id], onDelete: SetNull)

  timestamp  DateTime  @default(now())
  status     String

  confidence Float?
  notes      String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId, timestamp])
  @@index([cameraId, timestamp])
  @@index([employeeId, timestamp])
  @@index([companyId, status, timestamp])
}

model OtRequisition {
  id         String   @id

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  cameraId   String?
  camera     Camera?   @relation(fields: [cameraId], references: [id], onDelete: SetNull)

  timestamp  DateTime  @default(now())

  confidence Float?
  notes      String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId, timestamp])
  @@index([cameraId, timestamp])
  @@index([employeeId, timestamp])
}

model GatepassTable {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId String?
  leaveType   String
  purpose     String
  destination String?

  outTime DateTime @default(now())
  inTime  DateTime?
  status  String   @default("out")

  requestCameraId String?
  requestCamera   Camera? @relation("GatepassRequestCamera", fields: [requestCameraId], references: [id], onDelete: SetNull)

  returnCameraId String?
  returnCamera   Camera? @relation("GatepassReturnCamera", fields: [returnCameraId], references: [id], onDelete: SetNull)

  externalSubmitAckAt DateTime?
  externalSubmitPayload Json?
  externalReturnAckAt DateTime?
  externalReturnPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passType String?
  remarks  String?

  externalGatepassId String?
  erpStatus          String?   @default("pending")

  @@index([companyId, outTime])
  @@index([companyId, status, outTime])
  @@index([companyId, leaveTypeId, status])
  @@index([companyId, leaveType, status])
  @@index([companyId, employeeId, status, outTime])
  @@index([requestCameraId])
  @@index([returnCameraId])
  @@map("GatepassTable")
}

model Visitor {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  visitorName       String
  contactNumber     String
  emailAddress      String?
  companyAddress    String
  visitorType       String
  purposeOfVisit    String
  department        String
  hostEmployeeId    String
  idProofType       String
  idProofNumber     String?
  vehicleNumber     String?
  extraGuest        String?
  visitorPassNo     String
  dateOfVisit       String
  timeIn            String
  entryAuthorizedBy String?
  remarks           String?
  visitorPhoto      String?  @db.Text

  status            String   @default("checked_in")
  timeOut           String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId])
  @@index([contactNumber])
}

model VisitorType {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model PurposeOfVisit {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}
