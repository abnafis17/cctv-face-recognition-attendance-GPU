generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                      String                      @id @default(cuid())
  companyName             String
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  organization_id         String?
  attendances             Attendance[]
  cameras                 Camera[]
  boundingBoxTrackingRows CameraBoundingBoxTracking[]
  refreshTokens           RefreshToken[]
  relayAgents             RelayAgent[]
  pairCodes               PairCode[]
  relaySettings           CompanyRelaySetting[]
  erpSettings             CompanyErpSetting[]
  employees               Employee[]
  faceTemplates           FaceTemplate[]
  gatepassRows            GatepassTable[]
  headcounts              Headcount[]
  otRequisitions          OtRequisition[]
  purposeOfVisits         PurposeOfVisit[]
  unknownRecognitions     UnknownRecognition[]
  users                   User[]
  permissions             Permission[]
  visitors                Visitor[]
  visitorFaceTemplates    VisitorFaceTemplate[]
  visitorTypes            VisitorType[]
  userRoles               UserRole[]
}

model User {
  id             String         @id @default(cuid())
  name           String?
  email          String         @unique
  passwordHash   String
  password       String?
  role           String         @default("ADMIN")
  isActive       Boolean        @default(true)
  profilePicture String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  companyId      String?
  refreshTokens  RefreshToken[]
  company        Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Permission {
  id        String   @id @default(cuid())
  role      String
  module    String   // e.g. "/cameras", "/camera-list", "/enroll", "/employees", "/daily-attendance", "/attendance", "/unknown-recognition", "gatepass", "visitors", "/master-data", "/settings", "/permissions"
  allowed   Boolean  @default(true)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, role, module])
  @@index([companyId])
}

model Module {
  id          String   @id @default(cuid())
  name        String
  route       String?
  description String?
  sortOrder   Int      @default(0)

  parentId    String?
  parent      Module?  @relation("SubModules", fields: [parentId], references: [id], onDelete: Cascade)
  subModules  Module[] @relation("SubModules")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([parentId])
  @@index([route])
}

model Employee {
  id                      String                      @id @default(cuid())
  name                    String
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  empId                   String?                     @map("emp_id")
  companyId               String?
  department              String?
  line                    String?
  section                 String?
  unit                    String?
  deptId                  String?
  sectionId               String?
  designationId           String?
  designation             String?
  unitId                  String?
  lineId                  String?
  empPicUrl               String?
  attendance              Attendance[]
  cameraAuthorizations    CameraAuthorizedEmployee[]
  boundingBoxAssignments  CameraBoundingBoxEmployee[]
  boundingBoxTrackingRows CameraBoundingBoxTracking[]
  company                 Company?                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  templates               FaceTemplate[]
  gatepassRows            GatepassTable[]
  headcounts              Headcount[]
  otRequisitions          OtRequisition[]

  @@unique([companyId, empId])
  @@index([empId])
  @@index([companyId])
  @@index([companyId, unit])
  @@index([companyId, section])
  @@index([companyId, department])
  @@index([companyId, line])
}

model FaceTemplate {
  id         String   @id @default(cuid())
  employeeId String
  angle      String
  modelName  String
  embedding  Float[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, angle])
  @@index([employeeId])
  @@index([companyId])
}

model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  timestamp  DateTime
  cameraId   String?
  confidence Float?
  createdAt  DateTime @default(now())
  companyId  String?
  camera     Camera?  @relation(fields: [cameraId], references: [id])
  company    Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, timestamp])
  @@index([companyId, timestamp])
}

model UnknownRecognition {
  id             String   @id @default(cuid())
  timestamp      DateTime
  confidence     Float?
  companyId      String?
  cameraId       String?
  createdAt      DateTime @default(now())
  recognizedName String?  @map("name")
  camera         Camera?  @relation(fields: [cameraId], references: [id])
  company        Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, timestamp])
  @@index([cameraId, timestamp])
}

model Camera {
  id                      String                      @id @default(cuid())
  name                    String
  rtspUrl                 String?
  isActive                Boolean                     @default(false)
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  camId                   String?                     @map("cam_id")
  companyId               String?
  jpegQuality             Int                         @default(70)
  relayAgentId            String?
  rtspUrlEnc              String?
  sendFps                 Int                         @default(2)
  sendHeight              Int                         @default(360)
  sendWidth               Int                         @default(640)
  attendance              Boolean?                    @default(false)
  task                    String                      @default("attendance")
  attendances             Attendance[]
  company                 Company?                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  relayAgent              RelayAgent?                 @relation(fields: [relayAgentId], references: [id])
  authorizedEmployees     CameraAuthorizedEmployee[]
  boundingBoxes           CameraBoundingBox[]
  boundingBoxTrackingRows CameraBoundingBoxTracking[]
  gatepassRequestRows     GatepassTable[]             @relation("GatepassRequestCamera")
  gatepassReturnRows      GatepassTable[]             @relation("GatepassReturnCamera")
  headcounts              Headcount[]
  otRequisitions          OtRequisition[]
  unknownRecognitions     UnknownRecognition[]

  @@unique([companyId, camId])
  @@index([camId])
  @@index([companyId])
  @@index([relayAgentId])
}

model CameraAuthorizedEmployee {
  cameraId   String
  employeeId String
  createdAt  DateTime @default(now())
  camera     Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([cameraId, employeeId])
  @@index([cameraId])
  @@index([employeeId])
}

model CameraBoundingBox {
  id           String                      @id @default(cuid())
  name         String
  cameraId     String
  sortOrder    Int                         @default(0)
  topLeftX     Float
  topLeftY     Float
  topRightX    Float
  topRightY    Float
  bottomLeftX  Float
  bottomLeftY  Float
  bottomRightX Float
  bottomRightY Float
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  camera       Camera                      @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  employees    CameraBoundingBoxEmployee[]
  trackingRows CameraBoundingBoxTracking[]

  @@index([cameraId])
  @@index([cameraId, sortOrder])
}

model CameraBoundingBoxEmployee {
  id            String            @id @default(cuid())
  boundingBoxId String
  employeeId    String
  createdAt     DateTime          @default(now())
  boundingBox   CameraBoundingBox @relation(fields: [boundingBoxId], references: [id], onDelete: Cascade)
  employee      Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([boundingBoxId, employeeId])
  @@index([boundingBoxId])
  @@index([employeeId])
}

model CameraBoundingBoxTracking {
  id              String            @id @default(cuid())
  companyId       String
  cameraId        String
  boundingBoxId   String
  employeeId      String
  outTime         DateTime
  inTime          DateTime?
  durationSeconds Int?
  status          String            @default("out")
  confidence      Float?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  boundingBox     CameraBoundingBox @relation(fields: [boundingBoxId], references: [id], onDelete: Cascade)
  camera          Camera            @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee        Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, outTime])
  @@index([cameraId, outTime])
  @@index([boundingBoxId, outTime])
  @@index([employeeId, outTime])
  @@index([companyId, cameraId, status, outTime])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  ip        String?
  userAgent String?
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
}

model RelayAgent {
  id               String     @id @default(cuid())
  name             String
  companyId        String?
  publicKeyPem     String
  refreshTokenHash String
  isActive         Boolean    @default(true)
  lastSeenAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  cameras          Camera[]
  pairCodes        PairCode[]
  company          Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@index([lastSeenAt])
}

model PairCode {
  code      String      @id
  companyId String?
  agentName String
  expiresAt DateTime
  usedAt    DateTime?
  agentId   String?
  createdAt DateTime    @default(now())
  agent     RelayAgent? @relation(fields: [agentId], references: [id])
  company   Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([expiresAt])
  @@index([agentId])
}

model CompanyRelaySetting {
  id             String   @id @default(cuid())
  companyId      String
  relayOnUrl     String?
  relaySilentUrl String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  urlType        String   @default("door")
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, urlType])
  @@index([companyId])
}

model CompanyErpSetting {
  id                    String   @id @default(cuid())
  companyId             String
  erpBaseUrl            String?
  erpPrefix             String?
  erpAttendanceEndpoint String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  urlType               String   @default("attendance")
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, urlType])
  @@index([companyId])
}

model Headcount {
  id         String    @id @default(cuid())
  employeeId String?
  companyId  String?
  cameraId   String?
  timestamp  DateTime  @default(now())
  status     String
  confidence Float?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  camera     Camera?   @relation(fields: [cameraId], references: [id])
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee? @relation(fields: [employeeId], references: [id])

  @@index([companyId, timestamp])
  @@index([cameraId, timestamp])
  @@index([employeeId, timestamp])
  @@index([companyId, status, timestamp])
}

model OtRequisition {
  id         String    @id
  employeeId String?
  companyId  String?
  cameraId   String?
  timestamp  DateTime  @default(now())
  confidence Float?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  camera     Camera?   @relation(fields: [cameraId], references: [id])
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee? @relation(fields: [employeeId], references: [id])

  @@index([companyId, timestamp])
  @@index([cameraId, timestamp])
  @@index([employeeId, timestamp])
}

model GatepassTable {
  id                    String    @id @default(cuid())
  companyId             String
  employeeId            String
  leaveType             String
  purpose               String
  destination           String?
  outTime               DateTime  @default(now())
  inTime                DateTime?
  status                String    @default("out")
  requestCameraId       String?
  returnCameraId        String?
  externalSubmitAckAt   DateTime?
  externalSubmitPayload Json?
  externalReturnAckAt   DateTime?
  externalReturnPayload Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  leaveTypeId           String?
  passType              String?
  remarks               String?
  returnTime            Int?
  erpStatus             String?   @default("pending")
  externalGatepassId    String?
  approvedByName        String?
  approvedByDesignation String?
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee              Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestCamera         Camera?   @relation("GatepassRequestCamera", fields: [requestCameraId], references: [id])
  returnCamera          Camera?   @relation("GatepassReturnCamera", fields: [returnCameraId], references: [id])

  @@index([companyId, outTime])
  @@index([companyId, status, outTime])
  @@index([companyId, leaveTypeId, status])
  @@index([companyId, leaveType, status])
  @@index([companyId, employeeId, status, outTime])
  @@index([requestCameraId])
  @@index([returnCameraId])
  @@map("GatepassTable")
}

model Visitor {
  id                    String   @id @default(cuid())
  companyId             String
  visitorName           String
  contactNumber         String
  emailAddress          String?
  companyAddress        String
  visitorType           String
  purposeOfVisit        String
  department            String
  hostEmployeeId        String
  hostEmployeeName      String   @default("")
  hostPicUrl            String?
  host_designation_id   String?
  host_designation_name String?
  idProofType           String
  idProofNumber         String?
  vehicleNumber         String?
  extraGuest            String?
  visitorPassNo         String
  dateOfVisit           String
  timeIn                String
  entryAuthorizedBy     String?
  remarks               String?
  visitorPhoto          String?  @db.Text
  status                String   @default("checked_in")
  timeOut               String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  templates             VisitorFaceTemplate[]

  @@index([companyId])
  @@index([contactNumber])
}

model VisitorFaceTemplate {
  id          String   @id @default(cuid())
  visitorId   String
  visitor     Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  modelName   String   @default("face-api")
  embedding   Float[]
  photoUrl    String?  @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([visitorId])
  @@index([companyId])
}

model VisitorType {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

model PurposeOfVisit {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

model UserRole {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}
